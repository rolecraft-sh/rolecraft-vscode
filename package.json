{
  "name": "rolecraft",
  "displayName": "RoleCraft - The Security-First Skill Manager for AI Agents",
  "description": "Install, manage, and discover AI agent skills from VS Code",
  "version": "0.3.0",
  "publisher": "rolecraft-sh",
  "icon": "media/icon.png",
  "author": {
    "name": "rolecraft-sh"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rolecraft-sh/rolecraft-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "skill",
        "aliases": ["SKILL", "skill"],
        "extensions": [".skill.md"]
      }
    ],
    "commands": [
      {
        "command": "rolecraft.install",
        "title": "Install Skill",
        "category": "RoleCraft"
      },
      {
        "command": "rolecraft.search",
        "title": "Search Skills",
        "category": "RoleCraft"
      },
      {
        "command": "rolecraft.list",
        "title": "List Skills",
        "category": "RoleCraft"
      },
      {
        "command": "rolecraft.remove",
        "title": "Remove Skill",
        "category": "RoleCraft"
      },
      {
        "command": "rolecraft.doctor",
        "title": "Doctor",
        "category": "RoleCraft"
      },
      {
        "command": "rolecraft.test",
        "title": "Test Skill",
        "category": "RoleCraft"
      },
      {
        "command": "rolecraft.init",
        "title": "Init New Skill",
        "category": "RoleCraft"
      },
      {
        "command": "rolecraft.mcp.install",
        "title": "Install MCP Server",
        "category": "RoleCraft"
      },
      {
        "command": "rolecraft.mcp.remove",
        "title": "Remove MCP Server",
        "category": "RoleCraft"
      },
      {
        "command": "rolecraft.profile.save",
        "title": "Save Profile",
        "category": "RoleCraft"
      },
      {
        "command": "rolecraft.profile.apply",
        "title": "Apply Profile",
        "category": "RoleCraft"
      },
      {
        "command": "rolecraft.profile.delete",
        "title": "Delete Profile",
        "category": "RoleCraft"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rolecraft",
          "title": "RoleCraft",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "rolecraft": [
        {
          "id": "rolecraft.skills",
          "name": "Skills",
          "icon": "media/icon.svg"
        },
        {
          "id": "rolecraft.mcp",
          "name": "MCP Servers",
          "icon": "media/icon.svg"
        },
        {
          "id": "rolecraft.profiles",
          "name": "Profiles",
          "icon": "media/icon.svg"
        },
        {
          "type": "webview",
          "id": "rolecraft.securityReport",
          "name": "Security Report",
          "icon": "media/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "rolecraft.mcp.install",
          "when": "view == rolecraft.mcp",
          "group": "navigation"
        },
        {
          "command": "rolecraft.profile.save",
          "when": "view == rolecraft.profiles",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "rolecraft.test",
          "when": "view == rolecraft.skills && viewItem == skillInstalled",
          "group": "1_test"
        },
        {
          "command": "rolecraft.remove",
          "when": "view == rolecraft.skills && viewItem == skillInstalled",
          "group": "2_actions"
        },
        {
          "command": "rolecraft.mcp.remove",
          "when": "view == rolecraft.mcp && viewItem == mcpServer",
          "group": "1_actions"
        },
        {
          "command": "rolecraft.profile.apply",
          "when": "view == rolecraft.profiles && viewItem == profileSaved",
          "group": "1_actions"
        },
        {
          "command": "rolecraft.profile.delete",
          "when": "view == rolecraft.profiles && viewItem == profileSaved",
          "group": "1_actions"
        }
      ]
    },
    "configuration": {
      "title": "RoleCraft",
      "properties": {
        "rolecraft.executablePath": {
          "type": "string",
          "default": "rolecraft",
          "description": "Path to RoleCraft CLI executable"
        },
        "rolecraft.autoDetectAgents": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect installed AI agents"
        },
        "rolecraft.defaultAgents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["cursor", "claude-code"],
          "description": "Default agents for skill installation"
        },
        "rolecraft.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show status bar item"
        },
        "rolecraft.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Auto-refresh tree views on changes"
        },
        "rolecraft.securityNotification": {
          "type": "string",
          "enum": ["warning", "error", "off"],
          "default": "warning",
          "description": "Security notification level"
        },
        "rolecraft.registryUrl": {
          "type": "string",
          "default": "https://registry.rolecraft.sh",
          "description": "Skill registry URL"
        },
        "rolecraft.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable validation for SKILL.md frontmatter"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npx tsx --test --test-concurrency=1 src/**/*.test.ts",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "typescript": "^5.5.0"
  }
}
